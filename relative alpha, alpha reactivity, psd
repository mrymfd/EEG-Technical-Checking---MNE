def get_band_power(psd, freqs, fmin, fmax):
    """Mean power in a frequency band."""
    mask = (freqs >= fmin) & (freqs <= fmax)
    return np.mean(psd[mask])


def get_iaf(psd, freqs, fmin=7, fmax=13):
    """
    Individual Alpha Frequency:
    Returns (peak_freq, peak_power, cog)
    cog = centre of gravity (weighted mean frequency)
    """
    mask  = (freqs >= fmin) & (freqs <= fmax)
    f_sub = freqs[mask]
    p_sub = psd[mask]
    peaks, props = find_peaks(p_sub, prominence=0.5)
    if len(peaks) == 0:
        peak_freq  = np.nan
        peak_power = np.nan
    else:
        best  = peaks[np.argmax(props['prominences'])]
        peak_freq  = f_sub[best]
        peak_power = 10 * np.log10(p_sub[best])
    # Centre of gravity
    cog = np.sum(f_sub * p_sub) / np.sum(p_sub)
    return peak_freq, peak_power, cog


def cohen_d(a, b):
    """Cohen's d for two arrays."""
    pooled_std = np.sqrt((np.std(a, ddof=1)**2 + np.std(b, ddof=1)**2) / 2)
    if pooled_std == 0:
        return np.nan
    return (np.mean(a) - np.mean(b)) / pooled_std


