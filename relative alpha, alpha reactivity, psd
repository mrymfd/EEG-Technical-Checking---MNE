            total_eo = get_band_power(p_eo, freqs_eo, 0.5, 20)
            total_ec = get_band_power(p_ec, freqs_ec, 0.5, 20)
            rel_eo   = get_band_power(p_eo, freqs_eo, 8, 12) / total_eo
            rel_ec   = get_band_power(p_ec, freqs_ec, 8, 12) / total_ec

