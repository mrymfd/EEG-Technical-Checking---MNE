# ==========================================
# PLOTTING HELPER
# ==========================================
def make_bar(ax, eo_val, ec_val, n_eo=None, n_ec=None, zero_line=False):
    vals   = [eo_val if not np.isnan(eo_val) else 0,
              ec_val if not np.isnan(ec_val) else 0]
    colors = ['#3498db', '#e74c3c']
    bars   = ax.bar(['Eyes\nOpen', 'Eyes\nClosed'],
                    vals, color=colors, alpha=0.75, width=0.5)

    for bar, val in zip(bars, [eo_val, ec_val]):
        if not np.isnan(val):
            ax.text(bar.get_x() + bar.get_width() / 2,
                    bar.get_height() + abs(bar.get_height()) * 0.01,
                    f'{val:.2f}',
                    ha='center', va='bottom', fontsize=8)

    if np.isnan(eo_val):
        ax.text(0.25, 0.5, 'excl.', ha='center', va='center',
                transform=ax.transAxes, color='grey', fontsize=8)
    if np.isnan(ec_val):
        ax.text(0.75, 0.5, 'excl.', ha='center', va='center',
                transform=ax.transAxes, color='grey', fontsize=8)

    if zero_line:
        ax.axhline(0, color='black', linewidth=0.8, linestyle='--')

    if n_eo is not None and n_ec is not None:
        ax.text(0.5, -0.18, f'n={n_eo} / n={n_ec}',
                ha='center', va='top',
                transform=ax.transAxes, fontsize=7, color='grey')

    # Zoom y-axis to data range so small differences are visible
    valid = [v for v in [eo_val, ec_val] if not np.isnan(v)]
    if valid:
        spread  = max(abs(max(valid) - min(valid)), 0.5)
        padding = spread * 3
        ax.set_ylim(min(valid) - padding, max(valid) + padding)

    ax.grid(True, alpha=0.3, axis='y')
    ax.spines['top'].set_visible(False)
    ax.spines['right'].set_visible(False)


# ==========================================
# PLOT — one figure per device per subject
# Row 1: Absolute alpha power (dB)
# Row 2: Relative alpha power (%)
# Row 3: Reactivity (EC - EO dB)
# Cols: one per channel
# ==========================================
for device in devices:
    dev_df = df[df['device'] == device]
    if dev_df.empty:
        continue

    subjects = sorted(dev_df['subject'].unique())

    for subject in subjects:
        sub_df = dev_df[dev_df['subject'] == subject]
        if sub_df.empty:
            continue

        fig, axes = plt.subplots(3, len(channels_to_plot),
                                  figsize=(4 * len(channels_to_plot), 11))

        for col_idx, ch in enumerate(channels_to_plot):
            row = sub_df[sub_df['channel'] == ch]

            if row.empty:
                for r in range(3):
                    axes[r, col_idx].axis('off')
                continue

            abs_eo = row['abs_EO_dB'].values[0]
            abs_ec = row['abs_EC_dB'].values[0]
            rel_eo = row['rel_EO_pct'].values[0]
            rel_ec = row['rel_EC_pct'].values[0]
            react  = row['reactivity_dB'].values[0]
            n_eo   = int(row['n_EO_trials'].values[0])
            n_ec   = int(row['n_EC_trials'].values[0])

            # --- Row 0: Absolute alpha power ---
            ax0 = axes[0, col_idx]
            make_bar(ax0, abs_eo, abs_ec, n_eo, n_ec)
            if col_idx == 0:
                ax0.set_ylabel('Absolute Alpha\nPower (dB)',
                               fontsize=10, fontweight='bold')
            ax0.set_title(f'Channel: {ch}', fontsize=11, fontweight='bold')

            # --- Row 1: Relative alpha power ---
            ax1 = axes[1, col_idx]
            make_bar(ax1, rel_eo, rel_ec, n_eo, n_ec)
            if col_idx == 0:
                ax1.set_ylabel('Relative Alpha\nPower (%)',
                               fontsize=10, fontweight='bold')

            # --- Row 2: Reactivity ---
            ax2 = axes[2, col_idx]
            if not np.isnan(react):
                bar_color = '#2ecc71' if react >= 0 else '#e74c3c'
                ax2.bar(['EC − EO'], [react],
                        color=bar_color, alpha=0.8, width=0.4)
                ax2.axhline(0, color='black', linewidth=0.8, linestyle='--')
                offset = abs(react) * 0.05
                ax2.text(0, react + (offset if react >= 0 else -offset),
                         f'{react:+.2f} dB',
                         ha='center',
                         va='bottom' if react >= 0 else 'top',
                         fontsize=9, fontweight='bold')
                spread = max(abs(react), 0.1)
                ax2.set_ylim(react - spread * 0.5,
                             react + spread * 0.5)
            else:
                ax2.text(0.5, 0.5, 'no data', ha='center', va='center',
                         transform=ax2.transAxes, color='grey')

            if col_idx == 0:
                ax2.set_ylabel('Reactivity\n(EC − EO, dB)',
                               fontsize=10, fontweight='bold')

            ax2.grid(True, alpha=0.3, axis='y')
            ax2.spines['top'].set_visible(False)
            ax2.spines['right'].set_visible(False)

        plt.suptitle(
            f'Device: {device} | Subject: {subject}\n'
            f'Row 1: Absolute Alpha Power (dB) — EO vs EC\n'
            f'Row 2: Relative Alpha Power (%) — EO vs EC\n'
            f'Row 3: Reactivity (EC − EO) — Green ✓ | Red ✗\n',
            fontsize=11
        )
        plt.tight_layout()
        save_path = os.path.join(
            edf_folder, f'AlphaMetrics_{device}_{subject}.png'
        )
        plt.savefig(save_path, dpi=200)
        plt.show()
        print(f"  Saved → {save_path}")

print("\n✅ Done.")
